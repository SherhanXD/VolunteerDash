{
  "name": "volunteerdash-backend",
  "version": "1.0.0",
  "private": true,
  "description": "VolunteerDash API server (Fastify + node:sqlite)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/cli/migrate.js",
    "seed": "node src/seed/cli.js reset",
    "seed:extend": "node src/seed/cli.js extend",
    "test": "node --test --test-concurrency=1 test/"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  }
}
